{
  "extends": ["//"],
  "tasks": {
    "build": { "outputs": ["dist/**", "src/generated/**"] },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "db:seed": {
      "cache": false,
      "dependsOn": ["build"],
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED", "DEMO_SEED"]
    },
    "test": {
      "env": ["DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG"]
    },
    "typecheck": {
      "dependsOn": ["build"]
    }
  }
}
