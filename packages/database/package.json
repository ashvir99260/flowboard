{
  "name": "@flowboard/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@flowboard/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "@node-rs/argon2": "2.2.2",
    "@flowboard/logger": "workspace:*"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-jest": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@jest/globals": "30.5.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "prettier": "@flowboard/config-prettier"
}
