{
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "exports": {
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./nest.json": "./nest.json",
    "./next.json": "./next.json",
    "./library.json": "./library.json",
    ".": "./base.json"
  },
  "name": "@flowboard/config-typescript",
  "prettier": "@flowboard/config-prettier",
  "private": true,
  "scripts": {
    "build": "node src/build.mjs",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
