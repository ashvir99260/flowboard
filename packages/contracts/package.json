{
  "name": "@flowboard/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "prettier": "@flowboard/config-prettier",
  "devDependencies": {
    "@flowboard/config-typescript": "workspace:*",
    "@flowboard/config-eslint": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "prettier": "3.9.10"
  }
}
