{
  "name": "@flowboard/config-eslint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/node.mjs",
    "./node": "./src/node.mjs",
    "./next": "./src/next.mjs"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "lint": "eslint . --max-warnings=0 && cd ../.. && eslint eslint.config.mjs scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "node --test test/*.test.mjs"
  },
  "prettier": "@flowboard/config-prettier",
  "dependencies": {
    "@eslint/js": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
