{
  "components": {
    "schemas": {
      "EmptyAuthBodyDto": {
        "additionalProperties": false,
        "default": {},
        "properties": {},
        "type": "object"
      },
      "ErrorResponseDto_Output": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "VALIDATION_FAILED",
                  "STATUS_NOT_AVAILABLE",
                  "FIELD_VALUE_INVALID",
                  "INVALID_PARENT",
                  "INVALID_ANCHOR",
                  "INVALID_CURSOR",
                  "UNAUTHENTICATED",
                  "SESSION_EXPIRED",
                  "REFRESH_REUSED",
                  "FORBIDDEN",
                  "MEMBERSHIP_REQUIRED",
                  "ORIGIN_REJECTED",
                  "NOT_FOUND",
                  "VERSION_CONFLICT",
                  "CONFIG_CONFLICT",
                  "CURSOR_STALE",
                  "STATUS_IN_USE",
                  "FIELD_IN_USE",
                  "CONFIG_INVALIDATES_TASKS",
                  "LAST_ADMIN",
                  "EMAIL_IN_USE",
                  "INVITATION_UNAVAILABLE",
                  "PAYLOAD_TOO_LARGE",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE"
                ],
                "type": "string"
              },
              "details": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "maxLength": 64,
                      "minLength": 1,
                      "type": "string"
                    },
                    "message": {
                      "maxLength": 500,
                      "minLength": 1,
                      "type": "string"
                    },
                    "path": {
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "maximum": 9007199254740991,
                            "minimum": 0,
                            "type": "integer"
                          }
                        ]
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "code",
                    "message",
                    "path"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "message": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
