{
  "name": "@flowboard/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.storybook.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "node --import ./test/dom.mjs --test test/*.test.mjs && pnpm run storybook:test",
    "storybook": "storybook dev --host localhost --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts"
  },
  "dependencies": {
    "@flowboard/contracts": "workspace:*",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "react-markdown": "10.1.0",
    "react-toastify": "11.1.0",
    "@mui/x-data-grid": "9.16.0",
    "@mui/system": "9.5.0",
    "@mui/x-date-pickers": "9.16.0",
    "dayjs": "1.11.23"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "vitest": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "vite": "8.3.5"
  },
  "prettier": "@flowboard/config-prettier",
  "peerDependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
