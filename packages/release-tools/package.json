{
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./publisher": {
      "types": "./dist/publisher.d.ts",
      "import": "./dist/publisher.js"
    }
  },
  "files": [
    "dist"
  ],
  "name": "@flowboard/release-tools",
  "prettier": "@flowboard/config-prettier",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deploy:preview": "node dist/deploy-cli.js",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "release:plan": "node dist/cli.js",
    "release:publish": "node dist/publish-cli.js",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
