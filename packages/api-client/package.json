{
  "name": "@flowboard/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/generated/sdk.gen.d.ts",
      "import": "./dist/generated/sdk.gen.js"
    },
    "./types": {
      "types": "./dist/generated/types.gen.d.ts",
      "import": "./dist/generated/types.gen.js"
    },
    "./tanstack-query": {
      "types": "./dist/generated/@tanstack/react-query.gen.d.ts",
      "import": "./dist/generated/@tanstack/react-query.gen.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate.mjs --check && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "api:generate": "node scripts/generate.mjs --write",
    "test": "node --test test/*.test.mjs && tsc -p test/tsconfig.json",
    "client:check": "node scripts/generate.mjs --check"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "@flowboard/openapi": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "react": "19.3.1",
    "@types/react": "19.3.0"
  },
  "prettier": "@flowboard/config-prettier",
  "dependencies": {
    "@tanstack/react-query": "5.104.5"
  },
  "peerDependencies": {
    "react": "19.3.1"
  }
}
