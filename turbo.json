{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "api:generate": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "client:check": {
      "cache": false,
      "outputs": []
    },
    "commitlint": {
      "cache": false,
      "outputs": []
    },
    "commitlint:ci": {
      "cache": false,
      "env": ["GITHUB_EVENT_NAME", "GITHUB_EVENT_PATH"],
      "outputs": []
    },
    "deploy:preview": {
      "cache": false,
      "dependsOn": ["build"],
      "env": [
        "CD_ENABLED",
        "GITHUB_TOKEN",
        "GITHUB_REPOSITORY",
        "GITHUB_REPOSITORY_ID",
        "GITHUB_SHA",
        "GITHUB_REF",
        "VERCEL_TOKEN",
        "VERCEL_PROJECT_ID",
        "VERCEL_TEAM_ID",
        "NORTHFLANK_API_TOKEN",
        "NORTHFLANK_PROJECT_ID",
        "NORTHFLANK_API_SERVICE_ID",
        "NORTHFLANK_WORKER_SERVICE_ID"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["HOST", "PORT", "NEXT_TELEMETRY_DISABLED", "LOG_LEVEL"],
      "persistent": true
    },
    "dev:docker": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["HOST", "PORT", "NODE_ENV", "NEXT_TELEMETRY_DISABLED", "LOG_LEVEL", "TSC_WATCHFILE"],
      "interruptible": true,
      "persistent": true
    },
    "docker:check": {
      "cache": false,
      "env": ["DOCKER_CONTEXT", "DOCKER_HOST", "DOCKER_CONFIG"],
      "outputs": []
    },
    "docker:dev:check": {
      "cache": false,
      "env": ["DOCKER_CONTEXT", "DOCKER_HOST", "DOCKER_CONFIG"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "hooks:install": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "openapi:check": {
      "cache": false,
      "outputs": []
    },
    "release:plan": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": []
    },
    "release:publish": {
      "cache": false,
      "dependsOn": ["build"],
      "env": ["GITHUB_TOKEN", "GITHUB_REPOSITORY", "GITHUB_SHA", "GITHUB_REF"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
