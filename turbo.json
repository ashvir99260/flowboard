{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT", "NEXT_TELEMETRY_DISABLED"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "docker:check": {
      "cache": false,
      "env": ["DOCKER_CONTEXT", "DOCKER_HOST", "DOCKER_CONFIG"],
      "outputs": []
    },
    "release:plan": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    }
  }
}
