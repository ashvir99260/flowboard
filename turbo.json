{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": ["HOST", "PORT", "NEXT_TELEMETRY_DISABLED"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "cache": false
    },
    "docker:check": {
      "cache": false,
      "env": ["DOCKER_CONTEXT", "DOCKER_HOST", "DOCKER_CONFIG"],
      "outputs": []
    },
    "release:plan": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "release:publish": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": ["GITHUB_TOKEN", "GITHUB_REPOSITORY", "GITHUB_SHA", "GITHUB_REF"]
    },
    "deploy:preview": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": [],
      "env": [
        "CD_ENABLED",
        "GITHUB_TOKEN",
        "GITHUB_REPOSITORY",
        "GITHUB_REPOSITORY_ID",
        "GITHUB_SHA",
        "GITHUB_REF",
        "VERCEL_TOKEN",
        "VERCEL_PROJECT_ID",
        "VERCEL_TEAM_ID",
        "NORTHFLANK_API_TOKEN",
        "NORTHFLANK_PROJECT_ID",
        "NORTHFLANK_API_SERVICE_ID",
        "NORTHFLANK_WORKER_SERVICE_ID"
      ]
    }
  }
}
