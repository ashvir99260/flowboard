{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "daemons": {
    "worker": {
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "root": ".",
      "terminationGracePeriodSeconds": 30
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "destination": {
        "service": "api"
      },
      "source": "/socket.io/(.*)"
    },
    {
      "destination": {
        "service": "api"
      },
      "source": "/docs"
    },
    {
      "destination": {
        "service": "api"
      },
      "source": "/docs/(.*)"
    },
    {
      "destination": {
        "service": "api"
      },
      "source": "/docs-json"
    },
    {
      "destination": {
        "service": "api"
      },
      "source": "/docs-yaml"
    },
    {
      "destination": {
        "service": "api"
      },
      "source": "/health/live"
    },
    {
      "destination": {
        "service": "api"
      },
      "source": "/health/ready"
    },
    {
      "destination": {
        "service": "web"
      },
      "source": "/(.*)"
    }
  ],
  "services": {
    "api": {
      "entrypoint": "Dockerfile.api",
      "root": ".",
      "runtime": "container"
    },
    "web": {
      "bindings": [
        {
          "env": "API_INTERNAL_URL",
          "format": "url",
          "service": "api",
          "type": "service"
        }
      ],
      "buildCommand": "cd ../.. && pnpm build --filter=@flowboard/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
      "root": "apps/web"
    }
  }
}
