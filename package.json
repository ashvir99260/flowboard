{
  "name": "flowboard",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "docker:check": "turbo run docker:check",
    "release:plan": "turbo run release:plan",
    "release:publish": "turbo run release:publish",
    "deploy:production": "turbo run deploy:production"
  },
  "prettier": "@flowboard/config-prettier",
  "devDependencies": {
    "@flowboard/config-prettier": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "@flowboard/config-eslint": "workspace:*"
  }
}
