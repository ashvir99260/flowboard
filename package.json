{
  "name": "flowboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "commitlint": "turbo run commitlint",
    "commitlint:ci": "turbo run commitlint:ci",
    "hooks:install": "turbo run hooks:install",
    "docker:check": "turbo run docker:check",
    "release:plan": "turbo run release:plan",
    "release:publish": "turbo run release:publish",
    "deploy:preview": "turbo run deploy:preview",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "gen:api": "turbo run api:generate",
    "openapi:check": "turbo run openapi:check",
    "docker:dev:check": "turbo run docker:dev:check"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-prettier": "workspace:*",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "prettier": "@flowboard/config-prettier"
}
