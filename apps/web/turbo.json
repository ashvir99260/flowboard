{
  "extends": ["//"],
  "tasks": {
    "api:generate": {
      "cache": false,
      "dependsOn": ["^api:generate"]
    },
    "build": {
      "env": ["NEXT_TELEMETRY_DISABLED"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "client:check": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "dev": {
      "env": [
        "NEXT_TELEMETRY_DISABLED",
        "PORT",
        "API_INTERNAL_URL",
        "WEB_ALLOWED_ORIGINS",
        "REALTIME_PUBLIC_URL"
      ]
    },
    "dev:docker": {
      "env": [
        "NEXT_TELEMETRY_DISABLED",
        "PORT",
        "NODE_ENV",
        "API_INTERNAL_URL",
        "WEB_ALLOWED_ORIGINS",
        "REALTIME_PUBLIC_URL"
      ],
      "interruptible": false
    },
    "test": {
      "env": ["NEXT_TELEMETRY_DISABLED"]
    }
  }
}
