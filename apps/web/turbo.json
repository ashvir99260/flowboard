{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["NEXT_TELEMETRY_DISABLED"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "env": ["NEXT_TELEMETRY_DISABLED", "PORT"]
    },
    "dev:docker": {
      "interruptible": false
    },
    "test": {
      "env": ["NEXT_TELEMETRY_DISABLED"]
    }
  }
}
