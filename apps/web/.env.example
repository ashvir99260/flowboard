PORT=3000
NEXT_TELEMETRY_DISABLED=1
# Server-only runtime settings; never prefix these with NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:3001
WEB_ALLOWED_ORIGINS=http://localhost:3000
# Docker Compose sets API_INTERNAL_URL=http://api:3001 in the web container.
# Vercel Services inject API_INTERNAL_URL from the web→api service binding; do not set it yourself.

# Browser-reachable origin for authenticated WebSockets (runtime configuration).
REALTIME_PUBLIC_URL=http://localhost:3001
# Local Compose: direct API port. Vercel Services: use the deployment's public web origin;
# /socket.io is rewritten to the internal api service (see root vercel.json).
