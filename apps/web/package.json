{
  "name": "@flowboard/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "test": "node --experimental-strip-types --conditions=react-server --test --test-concurrency=1 --test-timeout=60000 test/*.test.mjs",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "dev:docker": "next dev --hostname 0.0.0.0"
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@flowboard/api-client": "workspace:*",
    "@flowboard/contracts": "workspace:*",
    "@flowboard/forms": "workspace:*",
    "@flowboard/ui": "workspace:*",
    "@hookform/resolvers": "5.9.2",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.104.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-jest": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "@axe-core/playwright": "4.14.0"
  },
  "prettier": "@flowboard/config-prettier"
}
