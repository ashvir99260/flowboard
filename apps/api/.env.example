HOST=localhost
PORT=3001
DATABASE_URL=postgresql://flowboard:flowboard-local-only@localhost:5432/flowboard?schema=public
DATABASE_URL_UNPOOLED=postgresql://flowboard:flowboard-local-only@localhost:5432/flowboard?schema=public
REDIS_URL=redis://localhost:6379
# Local demo only. Hosted deployments inject secrets, use HTTPS and disable demo seed.
DEMO_SEED=true
API_DOCS=true
API_DOCS_BASE_PATH=/
AUTH_SECRET=flowboard-local-only-change-before-hosting-64-bytes
# Include the web and Swagger browser origins. Match these if changing their ports.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ALLOW_INSECURE_HTTP=true

# Structured logs: trace/debug/info/warn/error/fatal/silent. Use debug locally to trace requests.
LOG_LEVEL=info
