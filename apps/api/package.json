{
  "name": "@flowboard/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./spec": {
      "types": "./dist/spec-bootstrap.d.ts",
      "import": "./dist/spec-bootstrap.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "test": "node --test --test-timeout=60000 test/bootstrap/*.test.mjs && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "docker:check": "node ../../scripts/check-compose.mjs"
  },
  "dependencies": {
    "@flowboard/contracts": "workspace:*",
    "@flowboard/database": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@nestjs/swagger": "11.4.7",
    "nestjs-zod": "5.5.0",
    "ioredis": "6.0.0",
    "zod": "4.6.7",
    "jose": "6.2.13",
    "@flowboard/logger": "workspace:*"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-jest": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "@nestjs/testing": "11.2.7",
    "@jest/globals": "30.5.2",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1"
  },
  "prettier": "@flowboard/config-prettier"
}
