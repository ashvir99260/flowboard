{
  "dependencies": {
    "@flowboard/contracts": "workspace:*",
    "@flowboard/database": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-jest": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "name": "@flowboard/api",
  "prettier": "@flowboard/config-prettier",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "docker:check": "node ../../scripts/check-compose.mjs",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "start": "node dist/main.js",
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "type": "module",
  "version": "0.0.0"
}
