{
  "name": "@flowboard/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix . --max-warnings=0",
    "test": "node --test --test-timeout=60000 test/*.test.mjs",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "dev:docker": "pnpm run dev"
  },
  "dependencies": {
    "@flowboard/contracts": "workspace:*",
    "@flowboard/database": "workspace:*",
    "@flowboard/logger": "workspace:*",
    "@flowboard/jobs": "workspace:*",
    "bullmq": "6.3.16",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@flowboard/config-eslint": "workspace:*",
    "@flowboard/config-jest": "workspace:*",
    "@flowboard/config-typescript": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3"
  },
  "prettier": "@flowboard/config-prettier"
}
