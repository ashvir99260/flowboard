# Local Compose defaults only. Do not use these credentials for a hosted database.
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_DB=flowboard
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard-local-only
# Only the local demo enables seed data. Hosted environments must leave this false.
DEMO_SEED=true
# Local Swagger UI. Hosted production defaults to disabled.
API_DOCS=true
# Development only. Hosted API: random secret (32+ bytes), exact HTTPS web origins, insecure=false.
AUTH_SECRET=flowboard-local-only-change-before-hosting-64-bytes
# Include the web and Swagger browser origins. Match these if changing WEB_PORT/API_PORT.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ALLOW_INSECURE_HTTP=true

# Structured logs: trace/debug/info/warn/error/fatal/silent. Use debug locally to trace requests.
LOG_LEVEL=info

# Browser-reachable API origin, injected at web runtime (not a build argument).
REALTIME_PUBLIC_URL=http://localhost:3001
